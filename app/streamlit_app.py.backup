# ---------------------------------------------------------
# DATABASE HEALTH
# ---------------------------------------------------------

database_ok, database_error = get_database_status()

st.title("🛡️ Mini SIEM Security Dashboard")

if database_ok:
    st.success("PostgreSQL connection: Connected", icon="🟢")
else:
    st.error("Cannot connect to PostgreSQL. Check your .env and database service.")
    with st.expander("Technical details"):
        st.code(database_error or "Unknown database error")
    st.stop()


# ---------------------------------------------------------
# OVERVIEW — SOC ANALYST WORKSPACE
# ---------------------------------------------------------

if page == "Overview":
    st.subheader("SOC Operations Center")
    st.caption(
        "Monitor security events, investigate suspicious activity, "
        "and track detection alerts."
    )

    start, end = get_time_range(days)

    # Full database counts for the selected time range
    total_events = fetch_scalar(
        select(func.count(Event.id)).where(
            Event.timestamp >= start,
            Event.timestamp < end,
        )
    )

    total_alerts = fetch_scalar(
        select(func.count(Alert.id)).where(
            Alert.created_at >= start,
            Alert.created_at < end,
        )
    )

    open_alerts = fetch_scalar(
        select(func.count(Alert.id)).where(
            Alert.status == "open",
            Alert.created_at >= start,
            Alert.created_at < end,
        )
    )

    open_incidents = fetch_scalar(
        select(func.count(Incident.id)).where(
            Incident.status == "open",
            Incident.created_at >= start,
            Incident.created_at < end,
        )
    )

    critical_alerts = fetch_scalar(
        select(func.count(Alert.id)).where(
            func.lower(Alert.severity) == "critical",
            Alert.created_at >= start,
            Alert.created_at < end,
        )
    )

    enabled_sources = fetch_scalar(
        select(func.count(LogSource.id)).where(LogSource.enabled.is_(True))
    )

    # KPI cards
    c1, c2, c3, c4, c5 = st.columns(5)

    c1.metric("Security Events", f"{total_events:,}")
    c2.metric("Alerts Generated", f"{total_alerts:,}")
    c3.metric("Open Alerts", f"{open_alerts:,}")
    c4.metric("Open Incidents", f"{open_incidents:,}")
    c5.metric("Critical Alerts", f"{critical_alerts:,}")

    st.caption(
        f"Configured enabled log sources: {enabled_sources} "
        f"• Selected period: last {days} day(s)"
    )

    # Load the existing dashboard data
    events_df = get_events(days)
    alerts_df = get_alerts(days)
    incidents_df = get_incidents(days)

    st.divider()

    # Event severity and alert-rule charts
    left, right = st.columns(2)

    with left:
        st.subheader("Event Severity Distribution")

        if not events_df.empty:
            severity_df = (
                events_df["Severity"]
                .fillna("unknown")
                .astype(str)
                .str.lower()
                .value_counts()
                .rename_axis("Severity")
                .reset_index(name="Count")
            )

            fig = px.bar(
                severity_df,
                x="Severity",
                y="Count",
                color="Severity",
                title="Events by severity",
                category_orders={
                    "Severity": [
                        "critical",
                        "high",
                        "medium",
                        "low",
                        "info",
                        "unknown",
                    ]
                },
            )
            fig.update_layout(
                margin=dict(l=10, r=10, t=50, b=10),
                legend_title_text="Severity",
            )
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No events in the selected period.")

    with right:
        st.subheader("Detection Rule Activity")

        if not alerts_df.empty:
            rule_df = (
                alerts_df["Detection Rule"]
                .fillna("unknown")
                .value_counts()
                .rename_axis("Detection Rule")
                .reset_index(name="Count")
                .sort_values("Count", ascending=True)
            )

            fig = px.bar(
                rule_df,
                x="Count",
                y="Detection Rule",
                orientation="h",
                title="Alerts by detection rule",
            )
            fig.update_layout(
                margin=dict(l=10, r=10, t=50, b=10),
                yaxis_title="",
            )
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No alerts in the selected period.")

    st.divider()

    # Event activity timeline
    st.subheader("Security Event Timeline")

    if not events_df.empty:
        timeline_df = events_df.copy()
        timeline_df["Timestamp"] = pd.to_datetime(
            timeline_df["Timestamp"], utc=True, errors="coerce"
        )
        timeline_df = timeline_df.dropna(subset=["Timestamp"])

        if not timeline_df.empty:
            timeline_df["Hour"] = timeline_df["Timestamp"].dt.floor("h")

            hourly_df = (
                timeline_df.groupby("Hour")
                .size()
                .reset_index(name="Events")
                .sort_values("Hour")
            )

            fig = px.line(
                hourly_df,
                x="Hour",
                y="Events",
                markers=True,
                title="Hourly event volume",
            )
            fig.update_layout(
                margin=dict(l=10, r=10, t=50, b=10),
                xaxis_title="Time (UTC)",
                yaxis_title="Events",
            )
            st.plotly_chart(fig, use_container_width=True)

            st.caption(
                "Timeline uses the most recent events returned by the "
                "dashboard query, not necessarily every event in the period."
            )
        else:
            st.info("Event timestamps could not be plotted.")
    else:
        st.info("No events available for the timeline.")

    st.divider()

    # Source IP investigation and alert queue
    left, right = st.columns([1, 1.5])

    with left:
        st.subheader("Top Source IPs")

        if not events_df.empty:
            ip_df = events_df.copy()
            ip_df["Source IP"] = ip_df["Source IP"].fillna("").astype(str).str.strip()
            ip_df = ip_df[
                (ip_df["Source IP"] != "") & (ip_df["Source IP"].str.lower() != "none")
            ]

            if not ip_df.empty:
                top_ips = (
                    ip_df["Source IP"]
                    .value_counts()
                    .head(10)
                    .rename_axis("Source IP")
                    .reset_index(name="Event Count")
                )

                st.dataframe(
                    top_ips,
                    use_container_width=True,
                    hide_index=True,
                )

                selected_ip = st.selectbox(
                    "Investigate source IP",
                    options=top_ips["Source IP"].tolist(),
                    key="overview_source_ip",
                )

                if st.button("Search this IP in Security Events"):
                    st.session_state["event_ip_search"] = selected_ip
                    st.session_state["soc_navigation"] = "Security Events"
                    st.rerun()
            else:
                st.info("No source IP addresses recorded.")
        else:
            st.info("No events available.")

    with right:
        st.subheader("High-Priority Alert Queue")

        if not alerts_df.empty:
            priority_df = alerts_df.copy()
            priority_df["_severity"] = (
                priority_df["Severity"].fillna("").astype(str).str.lower()
            )
            priority_df["_status"] = (
                priority_df["Status"].fillna("").astype(str).str.lower()
            )

            priority_df = priority_df[
                priority_df["_severity"].isin(["critical", "high"])
                & priority_df["_status"].isin(["open", "new", "acknowledged"])
            ].copy()

            priority_df = priority_df.drop(columns=["_severity", "_status"])

            if not priority_df.empty:
                st.dataframe(
                    priority_df.drop(columns=["Description"]),
                    use_container_width=True,
                    hide_index=True,
                )
            else:
                st.success(
                    "No open critical/high-severity alerts "
                    "in the loaded alert records."
                )
        else:
            st.info("No alerts available.")

    st.divider()

    # Recent alerts
    st.subheader("Recent Security Alerts")

    if not alerts_df.empty:
        st.dataframe(
            alerts_df.drop(columns=["Description"]),
            use_container_width=True,
            hide_index=True,
        )
    else:
        st.info("No recent alerts.")

    # Recent events
    st.subheader("Recent Security Events")

    if not events_df.empty:
        st.dataframe(
            events_df.head(20),
            use_container_width=True,
            hide_index=True,
        )
    else:
        st.info("No recent events.")

    # Recent incidents
    st.subheader("Recent Incidents")

    if not incidents_df.empty:
        st.dataframe(
            incidents_df.drop(columns=["Description"]).head(10),
            use_container_width=True,
            hide_index=True,
        )
    else:
        st.info("No incidents found in the selected period.")


# ---------------------------------------------------------
# SECURITY EVENTS
# ---------------------------------------------------------

elif page == "Security Events":
    st.subheader("Security Event Explorer")
    st.caption("Search normalized events stored in PostgreSQL.")

    events_df = get_events(days)

    if events_df.empty:
        st.info("No events found in this time range.")
    else:
        filter1, filter2, filter3 = st.columns(3)

        with filter1:
            severities = sorted(events_df["Severity"].dropna().unique().tolist())
            selected_severities = st.multiselect(
                "Severity",
                severities,
                default=severities,
            )

        with filter2:
            statuses = sorted(events_df["Status"].dropna().unique().tolist())
            selected_statuses = st.multiselect(
                "Event status",
                statuses,
                default=statuses,
            )

        with filter3:
            event_types = sorted(events_df["Event Type"].dropna().unique().tolist())
            selected_types = st.multiselect(
                "Event type",
                event_types,
                default=event_types,
            )

        source_ip = st.text_input(
            "Filter by source IP",
            value=st.session_state.pop("event_ip_search", ""),
        )
        username = st.text_input("Filter by username")
        search_text = st.text_input("Search event message")

        filtered = events_df[
            events_df["Severity"].isin(selected_severities)
            & events_df["Status"].isin(selected_statuses)
            & events_df["Event Type"].isin(selected_types)
        ].copy()

        if source_ip.strip():
            filtered = filtered[
                filtered["Source IP"]
                .fillna("")
                .str.contains(source_ip.strip(), case=False, regex=False)
            ]

        if username.strip():
            filtered = filtered[
                filtered["Username"]
                .fillna("")
                .str.contains(username.strip(), case=False, regex=False)
            ]

        if search_text.strip():
            filtered = filtered[
                filtered["Message"]
                .fillna("")
                .str.contains(search_text.strip(), case=False, regex=False)
            ]

        st.metric("Matching Events", f"{len(filtered):,}")

        st.dataframe(
            filtered,
            use_container_width=True,
            hide_index=True,
        )

        st.download_button(
            "Download filtered events as CSV",
            data=filtered.to_csv(index=False).encode("utf-8"),
            file_name="mini_siem_events.csv",
            mime="text/csv",
        )


# ---------------------------------------------------------
# ALERTS
# ---------------------------------------------------------

elif page == "Alerts":
    st.subheader("Security Alerts")
    st.caption(
        "Investigate detection alerts, review correlated events, "
        "and manage alert status."
    )

    alerts_df = get_alerts(days)

    if alerts_df.empty:
        st.info("No alerts found in this time range.")
    else:
        # -------------------------------------------------
        # ALERT FILTERS
        # -------------------------------------------------

        filter1, filter2 = st.columns(2)

        with filter1:
            alert_statuses = sorted(
                alerts_df["Status"].dropna().astype(str).unique().tolist()
            )

            selected_status = st.multiselect(
                "Alert status",
                alert_statuses,
                default=alert_statuses,
                key="alert_status_filter",
            )

        with filter2:
            alert_severities = sorted(
                alerts_df["Severity"].dropna().astype(str).unique().tolist()
            )

            selected_severity = st.multiselect(
                "Alert severity",
                alert_severities,
                default=alert_severities,
                key="alert_severity_filter",
            )

        filtered = alerts_df[
            alerts_df["Status"].isin(selected_status)
            & alerts_df["Severity"].isin(selected_severity)
        ].copy()

        st.metric(
            "Matching Alerts",
            f"{len(filtered):,}",
        )

        # -------------------------------------------------
        # ALERT TABLE
        # -------------------------------------------------

        st.dataframe(
            filtered,
            use_container_width=True,
            hide_index=True,
        )

        st.download_button(
            "Download alerts as CSV",
            data=filtered.to_csv(index=False).encode("utf-8"),
            file_name="mini_siem_alerts.csv",
            mime="text/csv",
        )

        st.divider()

        # -------------------------------------------------
        # ALERT INVESTIGATION
        # -------------------------------------------------

        st.subheader("Alert Investigation")

        if filtered.empty:
            st.info("No alerts match the selected filters.")
        else:
            # The dataframe returned by get_alerts() contains
            # the database alert ID as "ID".
            alert_ids = filtered["ID"].tolist()

            selected_alert_id = st.selectbox(
                "Select an alert to investigate",
                alert_ids,
                format_func=lambda alert_id: (f"Alert #{alert_id}"),
                key="selected_alert_id",
            )

            alert = get_alert_by_id(int(selected_alert_id))

            if alert is None:
                st.error(f"Alert #{selected_alert_id} could not be found.")
            else:
                # -----------------------------------------
                # ALERT SUMMARY
                # -----------------------------------------

                st.markdown(f"### Alert #{alert.id}: {alert.title}")

                summary1, summary2, summary3, summary4 = st.columns(4)

                summary1.metric(
                    "Severity",
                    alert.severity.upper() if alert.severity else "UNKNOWN",
                )

                summary2.metric(
                    "Status",
                    alert.status.upper() if alert.status else "UNKNOWN",
                )

                summary3.metric(
                    "Source IP",
                    alert.src_ip or "N/A",
                )

                summary4.metric(
                    "Username",
                    alert.username or "N/A",
                )

                # -----------------------------------------
                # ALERT DETAILS
                # -----------------------------------------

                detail1, detail2 = st.columns(2)

                with detail1:
                    st.markdown("**Detection Rule**")
                    st.code(alert.rule_name or "unknown")

                    st.markdown("**Created At**")
                    st.write(str(alert.created_at) if alert.created_at else "N/A")

                with detail2:
                    st.markdown("**Description**")
                    st.write(alert.description or "No description available.")

                # -----------------------------------------
                # ALERT STATUS MANAGEMENT
                # -----------------------------------------

                st.markdown("### Alert Status")

                status_options = [
                    "open",
                    "acknowledged",
                    "resolved",
                ]

                current_status = (
                    alert.status if alert.status in status_options else "open"
                )

                new_alert_status = st.selectbox(
                    "Change alert status",
                    status_options,
                    index=status_options.index(current_status),
                    key=f"alert_status_{alert.id}",
                )

                if st.button(
                    "Update Alert Status",
                    key=f"update_alert_{alert.id}",
                    type="primary",
                ):
                    if new_alert_status == alert.status:
                        st.info("Alert is already in that status.")
                    else:
                        success, message = update_alert_status(
                            alert.id,
                            new_alert_status,
                        )

                        if success:
                            st.success(message)
                            st.rerun()
                        else:
                            st.error(message)

                st.divider()

                # -----------------------------------------
                # CORRELATED EVENTS
                # -----------------------------------------

                st.markdown("### Correlated Security Events")

                correlated_events = get_alert_events(alert.id)

                if not correlated_events:
                    st.info("No correlated events are linked to this alert.")
                else:
                    st.metric(
                        "Correlated Events",
                        len(correlated_events),
                    )

                    event_rows = []

                    for event in correlated_events:
                        event_rows.append(
                            {
                                "ID": event.id,
                                "Timestamp": event.timestamp,
                                "Event Type": event.event_type,
                                "Action": event.action,
                                "Username": event.username,
                                "Source IP": event.src_ip,
                                "Source Port": event.src_port,
                                "Destination IP": event.dst_ip,
                                "Destination Port": event.dst_port,
                                "Status": event.status,
                                "Severity": event.severity,
                                "Message": event.message,
                            }
                        )

                    correlated_df = pd.DataFrame(event_rows)

                    st.dataframe(
                        correlated_df,
                        use_container_width=True,
                        hide_index=True,
                    )

                    st.download_button(
                        "Download correlated events",
                        data=correlated_df.to_csv(index=False).encode("utf-8"),
                        file_name=(f"alert_{alert.id}_events.csv"),
                        mime="text/csv",
                        key=f"download_alert_events_{alert.id}",
                    )

                    # -------------------------------------
                    # EVENT DETAILS
                    # -------------------------------------

                    st.markdown("### Event Details")

                    event_ids = [event.id for event in correlated_events]

                    selected_event_id = st.selectbox(
                        "Select a correlated event",
                        event_ids,
                        format_func=lambda event_id: (f"Event #{event_id}"),
                        key=f"selected_event_{alert.id}",
                    )

                    selected_event = next(
                        (
                            event
                            for event in correlated_events
                            if event.id == selected_event_id
                        ),
                        None,
                    )

                    if selected_event:
                        event_col1, event_col2 = st.columns(2)

                        with event_col1:
                            st.write(f"**Event ID:** " f"{selected_event.id}")

                            st.write(f"**Timestamp:** " f"{selected_event.timestamp}")

                            st.write(f"**Event Type:** " f"{selected_event.event_type}")

                            st.write(f"**Action:** " f"{selected_event.action}")

                            st.write(f"**Status:** " f"{selected_event.status}")

                        with event_col2:
                            st.write(
                                f"**Username:** " f"{selected_event.username or 'N/A'}"
                            )

                            st.write(
                                f"**Source IP:** " f"{selected_event.src_ip or 'N/A'}"
                            )

                            st.write(
                                f"**Source Port:** "
                                f"{selected_event.src_port or 'N/A'}"
                            )

                            st.write(
                                f"**Destination IP:** "
                                f"{selected_event.dst_ip or 'N/A'}"
                            )

                            st.write(
                                f"**Severity:** " f"{selected_event.severity or 'N/A'}"
                            )

                        st.markdown("**Message**")
                        st.info(selected_event.message or "No message available.")

                        with st.expander("View raw log"):
                            st.code(selected_event.raw_log or "No raw log available.")
# ---------------------------------------------------------
# INCIDENTS
# ---------------------------------------------------------

elif page == "Incidents":
    st.subheader("Incident Management")
    st.caption(
        "Investigate incidents, review associated alerts "
        "and correlated security events."
    )

    incidents_df = get_incidents(days)

    if incidents_df.empty:
        st.info("No incidents found in this time range.")
    else:
        # -------------------------------------------------
        # INCIDENT FILTER
        # -------------------------------------------------

        statuses = sorted(incidents_df["Status"].dropna().astype(str).unique().tolist())

        selected_status = st.multiselect(
            "Incident status",
            statuses,
            default=statuses,
            key="incident_status_filter",
        )

        filtered = incidents_df[incidents_df["Status"].isin(selected_status)].copy()

        st.metric(
            "Matching Incidents",
            f"{len(filtered):,}",
        )

        # -------------------------------------------------
        # INCIDENT TABLE
        # -------------------------------------------------

        st.dataframe(
            filtered,
            use_container_width=True,
            hide_index=True,
        )

        st.download_button(
            "Download incidents as CSV",
            data=filtered.to_csv(index=False).encode("utf-8"),
            file_name="mini_siem_incidents.csv",
            mime="text/csv",
        )

        st.divider()

        # -------------------------------------------------
        # INCIDENT INVESTIGATION
        # -------------------------------------------------

        st.subheader("Incident Investigation")

        if filtered.empty:
            st.info("No incidents match the selected filters.")
        else:
            incident_ids = filtered["ID"].tolist()

            selected_incident_id = st.selectbox(
                "Select an incident to investigate",
                incident_ids,
                format_func=lambda incident_id: (f"Incident #{incident_id}"),
                key="selected_incident_id",
            )

            incident = get_incident_by_id(int(selected_incident_id))

            if incident is None:
                st.error(f"Incident #{selected_incident_id} " "could not be found.")
            else:
                # -----------------------------------------
                # INCIDENT SUMMARY
                # -----------------------------------------

                st.markdown(f"### Incident #{incident.id}: " f"{incident.title}")

                summary1, summary2, summary3, summary4 = st.columns(4)

                summary1.metric(
                    "Severity",
                    incident.severity.upper() if incident.severity else "UNKNOWN",
                )

                summary2.metric(
                    "Status",
                    incident.status.upper() if incident.status else "UNKNOWN",
                )

                summary3.metric(
                    "Alert ID",
                    incident.alert_id if incident.alert_id is not None else "N/A",
                )

                summary4.metric(
                    "Updated",
                    str(incident.updated_at) if incident.updated_at else "N/A",
                )

                # -----------------------------------------
                # INCIDENT DETAILS
                # -----------------------------------------

                st.markdown("### Incident Details")

                st.write(incident.description or "No description available.")

                detail1, detail2 = st.columns(2)

                with detail1:
                    st.markdown("**Created At**")
                    st.write(str(incident.created_at) if incident.created_at else "N/A")

                with detail2:
                    st.markdown("**Last Updated**")
                    st.write(str(incident.updated_at) if incident.updated_at else "N/A")

                # -----------------------------------------
                # INCIDENT STATUS
                # -----------------------------------------

                st.markdown("### Incident Status")

                incident_status_options = [
                    "open",
                    "in_progress",
                    "resolved",
                    "closed",
                ]

                current_incident_status = (
                    incident.status
                    if incident.status in incident_status_options
                    else "open"
                )

                new_incident_status = st.selectbox(
                    "Change incident status",
                    incident_status_options,
                    index=incident_status_options.index(current_incident_status),
                    key=f"incident_status_{incident.id}",
                )

                if st.button(
                    "Update Incident Status",
                    key=f"update_incident_{incident.id}",
                    type="primary",
                ):
                    if new_incident_status == incident.status:
                        st.info("Incident is already in that status.")
                    else:
                        success, message = update_incident_status(
                            incident.id,
                            new_incident_status,
                        )

                        if success:
                            st.success(message)
                            st.rerun()
                        else:
                            st.error(message)

                st.divider()

                # -----------------------------------------
                # ASSOCIATED ALERT
                # -----------------------------------------

                st.markdown("### Associated Alert")

                associated_alert = get_incident_alert(incident)

                if associated_alert is None:
                    st.info("This incident has no associated alert.")
                else:
                    alert_col1, alert_col2 = st.columns(2)

                    with alert_col1:
                        st.write(f"**Alert ID:** " f"{associated_alert.id}")

                        st.write(f"**Rule:** " f"{associated_alert.rule_name}")

                        st.write(f"**Severity:** " f"{associated_alert.severity}")

                    with alert_col2:
                        st.write(f"**Status:** " f"{associated_alert.status}")

                        st.write(
                            f"**Source IP:** " f"{associated_alert.src_ip or 'N/A'}"
                        )

                        st.write(
                            f"**Username:** " f"{associated_alert.username or 'N/A'}"
                        )

                    st.markdown("**Alert Description**")
                    st.write(
                        associated_alert.description or "No description available."
                    )

                st.divider()

                # -----------------------------------------
                # CORRELATED EVENTS
                # -----------------------------------------

                st.markdown("### Incident Correlated Events")

                if associated_alert is None:
                    st.info(
                        "No alert is associated with this incident, "
                        "so correlated events cannot be displayed."
                    )
                else:
                    correlated_events = get_alert_events(associated_alert.id)

                    if not correlated_events:
                        st.info("No correlated events found.")
                    else:
                        st.metric(
                            "Correlated Events",
                            len(correlated_events),
                        )

                        event_rows = []

                        for event in correlated_events:
                            event_rows.append(
                                {
                                    "ID": event.id,
                                    "Timestamp": event.timestamp,
                                    "Event Type": event.event_type,
                                    "Action": event.action,
                                    "Username": event.username,
                                    "Source IP": event.src_ip,
                                    "Source Port": event.src_port,
                                    "Destination IP": event.dst_ip,
                                    "Destination Port": event.dst_port,
                                    "Status": event.status,
                                    "Severity": event.severity,
                                    "Message": event.message,
                                }
                            )

                        correlated_df = pd.DataFrame(event_rows)

                        st.dataframe(
                            correlated_df,
                            use_container_width=True,
                            hide_index=True,
                        )

                        st.download_button(
                            "Download incident events",
                            data=correlated_df.to_csv(index=False).encode("utf-8"),
                            file_name=(f"incident_{incident.id}" "_events.csv"),
                            mime="text/csv",
                            key=(f"download_incident_events_" f"{incident.id}"),
                        )

                        # ---------------------------------
                        # INCIDENT EVENT TIMELINE
                        # ---------------------------------

                        st.markdown("### Investigation Timeline")

                        timeline_df = correlated_df.copy()

                        timeline_df["Timestamp"] = pd.to_datetime(
                            timeline_df["Timestamp"],
                            utc=True,
                            errors="coerce",
                        )

                        timeline_df = timeline_df.dropna(subset=["Timestamp"])

                        if not timeline_df.empty:
                            timeline_display = timeline_df[
                                [
                                    "Timestamp",
                                    "Severity",
                                    "Event Type",
                                    "Action",
                                    "Source IP",
                                    "Username",
                                    "Status",
                                    "Message",
                                ]
                            ].sort_values("Timestamp")

                            st.dataframe(
                                timeline_display,
                                use_container_width=True,
                                hide_index=True,
                            )
                        else:
                            st.info("Event timestamps could not " "be displayed.")

                        # ---------------------------------
                        # EVENT DETAILS
                        # ---------------------------------

                        st.markdown("### Event Details")

                        event_ids = [event.id for event in correlated_events]

                        selected_event_id = st.selectbox(
                            "Select an event",
                            event_ids,
                            format_func=lambda event_id: (f"Event #{event_id}"),
                            key=(f"selected_incident_event_" f"{incident.id}"),
                        )

                        selected_event = next(
                            (
                                event
                                for event in correlated_events
                                if event.id == selected_event_id
                            ),
                            None,
                        )

                        if selected_event:
                            event_col1, event_col2 = st.columns(2)

                            with event_col1:
                                st.write(f"**Event ID:** " f"{selected_event.id}")

                                st.write(
                                    f"**Timestamp:** " f"{selected_event.timestamp}"
                                )

                                st.write(
                                    f"**Event Type:** " f"{selected_event.event_type}"
                                )

                                st.write(f"**Action:** " f"{selected_event.action}")

                                st.write(f"**Status:** " f"{selected_event.status}")

                            with event_col2:
                                st.write(
                                    f"**Username:** "
                                    f"{selected_event.username or 'N/A'}"
                                )

                                st.write(
                                    f"**Source IP:** "
                                    f"{selected_event.src_ip or 'N/A'}"
                                )

                                st.write(
                                    f"**Source Port:** "
                                    f"{selected_event.src_port or 'N/A'}"
                                )

                                st.write(
                                    f"**Destination IP:** "
                                    f"{selected_event.dst_ip or 'N/A'}"
                                )

                                st.write(
                                    f"**Destination Port:** "
                                    f"{selected_event.dst_port or 'N/A'}"
                                )

                                st.write(
                                    f"**Severity:** "
                                    f"{selected_event.severity or 'N/A'}"
                                )

                            st.markdown("**Message**")
                            st.info(selected_event.message or "No message available.")

                            with st.expander("View raw log"):
                                st.code(
                                    selected_event.raw_log or "No raw log available."
                                )


# ---------------------------------------------------------
# LOG SOURCES
# ---------------------------------------------------------

elif page == "Log Sources":
    st.subheader("Configured Log Sources")

    sources_df = get_log_sources()

    if sources_df.empty:
        st.info("No log sources are registered yet.")
    else:
        source1, source2 = st.columns(2)

        source1.metric("Registered Sources", len(sources_df))
        source2.metric(
            "Enabled Sources",
            int(sources_df["Enabled"].fillna(False).sum()),
        )

        st.dataframe(
            sources_df,
            use_container_width=True,
            hide_index=True,
        )

        st.caption(
            "Enabled indicates the source's database configuration. "
            "It does not independently confirm that a collector is running."
        )

st.divider()
st.caption(
    "Mini SIEM | Local security analytics | "
    "Data displayed from your PostgreSQL database"
)
